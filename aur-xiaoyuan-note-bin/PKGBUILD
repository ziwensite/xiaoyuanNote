# Maintainer: zhitong <dev@XIAOYUAN_NOTE.local>
pkgname=XIAOYUAN_NOTE-bin
pkgver=4.11.13
pkgrel=1
pkgdesc='A lightweight Markdown and plain text editor built with Tauri 2'
arch=('x86_64')
url='https://XIAOYUAN_NOTE.app'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg' 'fuse2')
optdepends=(
    'wl-clipboard: clipboard image support on Wayland'
    'xclip: clipboard image support on X11'
)
provides=('XIAOYUAN_NOTE')
conflicts=('XIAOYUAN_NOTE')
options=('!strip' '!debug')
source=("${pkgname}-${pkgver}.AppImage::https://github.com/zhitongblog/XIAOYUAN_NOTE/releases/download/v${pkgver}/XIAOYUAN_NOTE_${pkgver}_amd64.AppImage"
        "XIAOYUAN_NOTE.desktop")
sha256sums=('b2fba77c80b60a0261c0208636b5dc4a568729210b3be38fc7fba7f687413e93'
            'SKIP')

prepare() {
    chmod +x "${pkgname}-${pkgver}.AppImage"
    "./${pkgname}-${pkgver}.AppImage" --appimage-extract 2>/dev/null || true
}

package() {
    # Install the AppImage binary
    install -Dm755 "${srcdir}/${pkgname}-${pkgver}.AppImage" \
        "${pkgdir}/opt/XIAOYUAN_NOTE/XIAOYUAN_NOTE.AppImage"

    # Install extracted icon if available, otherwise skip
    if [ -d "${srcdir}/squashfs-root" ]; then
        find "${srcdir}/squashfs-root" -name "*.png" -path "*/128x128/*" \
            -exec install -Dm644 {} "${pkgdir}/usr/share/icons/hicolor/128x128/apps/XIAOYUAN_NOTE.png" \; 2>/dev/null || true
    fi

    # Install desktop file
    install -Dm644 "${srcdir}/XIAOYUAN_NOTE.desktop" \
        "${pkgdir}/usr/share/applications/XIAOYUAN_NOTE.desktop"

    # Create /usr/bin symlinks (both XIAOYUAN_NOTE and XIAOYUAN_NOTE)
    install -dm755 "${pkgdir}/usr/bin"
    ln -sf /opt/XIAOYUAN_NOTE/XIAOYUAN_NOTE.AppImage "${pkgdir}/usr/bin/XIAOYUAN_NOTE"
    ln -sf /opt/XIAOYUAN_NOTE/XIAOYUAN_NOTE.AppImage "${pkgdir}/usr/bin/XIAOYUAN_NOTE"
}
