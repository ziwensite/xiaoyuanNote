---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Giscus from '../../components/Giscus.astro';
import CompareFaq from '../../components/CompareFaq.astro';

const lang = 'en' as const;
const FAQ = [
  {
    q: 'How do I install the xiaoyuanNote CLI?',
    a: 'macOS / Linux: curl -fsSL https://raw.githubusercontent.com/zhitongblog/xiaoyuan-note/main/scripts/install-cli.sh | bash — it drops the xiaoyuanNote binary into /usr/local/bin. On Windows, download xiaoyuan-note.exe from the GitHub releases page and add it to PATH.',
  },
  {
    q: 'What can the CLI do?',
    a: 'Open a note in the app (fuzzy title match), create a note, list files, grep the vault, and print a note to stdout: xiaoyuanNote open / new / list / search / cat. It exercises the same domain functions as the GUI and is built for shell pipelines and cron jobs.',
  },
  {
    q: 'Can I pipe notes into other tools?',
    a: 'Yes — xiaoyuanNote cat prints raw Markdown to stdout, so it composes with pandoc, fzf, grep, or anything else in a pipeline.',
  },
];
---

<Layout
  title="xiaoyuanNote CLI — Open, Search, Write Your Notes from the Terminal"
  description="The xiaoyuanNote CLI lets you create notes, search the vault, and pipe Markdown around without leaving the shell."
  lang={lang}
>
  <Header lang={lang} />
  <main id="main">
    <article class="container docs-article">
      <nav class="breadcrumbs">
        <a href="/">Home</a> / <a href="/docs/">Docs</a> / <span>CLI</span>
      </nav>

      <h1>xiaoyuanNote CLI</h1>
      <p class="lead">
        <code>xiaoyuanNote</code> is a small binary that exercises the same domain
        functions as the GUI — open a note, create one, search the vault, list
        files, print to stdout. Built for shell pipelines, cron jobs, and
        muscle-memory ops.
      </p>

      <h2>Install</h2>
      <p>
        macOS / Linux — paste this in your terminal:
      </p>
      <pre class="code"><code>curl -fsSL https://raw.githubusercontent.com/zhitongblog/xiaoyuan-note/main/scripts/install-cli.sh | bash</code></pre>
      <p>
        It drops a <code>xiaoyuanNote</code> binary into <code>/usr/local/bin</code>.
        Windows users can grab the standalone <code>xiaoyuan-note.exe</code> from
        <a href="https://github.com/zhitongblog/xiaoyuan-note/releases" rel="external">the releases page</a>
        and add it to <code>%PATH%</code>.
      </p>

      <h2>Subcommands</h2>
      <table class="kb-table">
        <thead><tr><th>Command</th><th>What it does</th></tr></thead>
        <tbody>
          <tr><th><code>xiaoyuanNote open &lt;title|path&gt;</code></th><td>Open a note in xiaoyuan-note. Title-as-arg uses fuzzy match against the vault.</td></tr>
          <tr><th><code>xiaoyuanNote new &lt;title&gt; [text]</code></th><td>Create a new note with the given title and optional body, then open it.</td></tr>
          <tr><th><code>xiaoyuanNote list [folder]</code></th><td>List Markdown files in the workspace (or a sub-folder).</td></tr>
          <tr><th><code>xiaoyuanNote search &lt;query&gt;</code></th><td>Grep your notes. Returns paths + matching lines.</td></tr>
          <tr><th><code>xiaoyuanNote cat &lt;title|path&gt;</code></th><td>Print a note to stdout — pipe into <code>pandoc</code>, <code>fzf</code>, anything.</td></tr>
          <tr><th><code>xiaoyuanNote help</code></th><td>Show the full subcommand list.</td></tr>
        </tbody>
      </table>

      <h2>Examples</h2>
      <pre class="code"><code>{`# Quick capture from anywhere
xiaoyuanNote new "standup 2026-04-26" "$(pbpaste)"

# Find every note that mentions "rust"
xiaoyuanNote search rust

# Pipe a note through pandoc
xiaoyuanNote cat "weekly-review" | pandoc -t docx -o weekly-review.docx

# Cron: append a daily journal stub each morning
xiaoyuanNote new "$(date +%F)" "## $(date +%A)\n\n- [ ] "`}</code></pre>

      <h2>How it finds your vault</h2>
      <p>
        The CLI reads the same <code>xiaoyuan-note-language</code> /
        <code>xiaoyuan-note-workspace</code> preference files the GUI writes. If
        you've opened a folder in xiaoyuanNote recently, the CLI will use that as
        its workspace. To override, set <code>XIAOYUAN_NOTE_WORKSPACE</code>:
      </p>
      <pre class="code"><code>XIAOYUAN_NOTE_WORKSPACE=/path/to/notes xiaoyuanNote list</code></pre>

      <h2>Combined with the MCP server</h2>
      <p>
        The CLI is what the user types; <code>xiaoyuan-note-mcp</code> is what the AI
        calls. They share the same workspace state, so a model can write a new
        note via MCP and you can immediately <code>xiaoyuanNote open</code> it from
        the terminal — no reload, no race.
      </p>
      <p>
        See <a href="/docs/mcp/">MCP server</a> for the AI side.
      </p>

      <p class="docs-footer">
        Bug or missing subcommand? Open an issue on
        <a href="https://github.com/zhitongblog/xiaoyuan-note/issues" rel="external">GitHub</a>.
      </p>

      <CompareFaq heading="Frequently asked questions" items={FAQ} />
    </article>
        <Giscus lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

<style>
  .docs-article { max-width: 820px; padding: 40px 20px 80px; }
  .breadcrumbs { font-size: 13px; color: var(--text-muted, #8a8a8a); margin-bottom: 16px; }
  .breadcrumbs a { color: inherit; }
  .docs-article h1 { font-size: 2rem; margin: 10px 0 16px; }
  .docs-article h2 { font-size: 1.4rem; margin: 32px 0 12px; }
  .docs-article .lead { color: var(--text-muted, #555); margin-bottom: 24px; line-height: 1.6; }
  .docs-article p { line-height: 1.7; margin: 12px 0; }
  .kb-table { width: 100%; border-collapse: collapse; margin: 14px 0 20px; font-size: 14px; }
  .kb-table th, .kb-table td { text-align: left; padding: 9px 12px; border-bottom: 1px solid #eee; }
  .kb-table thead th { background: #fafafa; font-weight: 600; }
  .kb-table tbody th { font-weight: 500; width: 38%; font-family: 'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace; font-size: 13px; }
  .docs-article code { background: #f5f5f0; padding: 2px 6px; border-radius: 4px; font-size: 0.9em; }
  .code { background: #f5f5f0; padding: 16px 18px; border-radius: 8px; overflow-x: auto; font-size: 13px; line-height: 1.55; margin: 14px 0; white-space: pre; }
  .code code { background: transparent; padding: 0; }
  .docs-footer { margin-top: 40px; font-size: 0.95rem; color: var(--text-muted, #555); }
</style>
